# SPDX-License-Identifier: Apache-2.0
#
# Internal image: vLLM (feat/obj-direct) + modelexpress + nixl (OBJ/RDMA fork).
#
# Three tiers, so day-to-day releases don't pay for the slow parts:
#   1. vLLM base: the official vllm/vllm-openai release image the branch is
#      rebased on (v0.34.0, pinned by digest). The branch is python-only vs
#      that tag, so tier 3 overlays the python sources onto its installed
#      package with zero drift. When rebasing, bump VLLM_IMAGE to the new tag.
#      If the branch ever changes csrc/, build tier 1 locally instead (hours):
#        DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile \
#            --target vllm-openai -t vllm-openai:obj-direct .
#      and pass --build-arg VLLM_IMAGE=vllm-openai:obj-direct to tier 3.
#   2. nixl-deps:26.08-cuda13.4 — ~45 min, rebuild only when a pin moves
#      (aws-sdk 1.11.760, UCX v1.23.x, base image tags):
#        DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.mx-deps \
#            -t nixl-deps:26.08-cuda13.4 .
#   3. vllm-mx:obj-direct — ~15 min, every change (vllm python, nixl,
#      modelexpress); BuildKit required for named contexts:
#        DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.mx \
#            --build-context nixl=/home/olivier-garaud/git/nixl \
#            --build-context modelexpress=/home/olivier-garaud/git/modelexpress \
#            -t vllm-mx:obj-direct .
#
# The final stage keeps vLLM's ENTRYPOINT ["vllm", "serve"]; run
# modelexpress-server as a second container in the same pod (shared network
# namespace) and point it at localhost:8001.

# Base images (must be declared before the first FROM to be visible to later
# FROM lines).
ARG VLLM_IMAGE=vllm/vllm-openai:v0.34.0@sha256:20fdb089454afbb324efa4110a2c025ff7b27cc1a086e07aa580b18df8ad1ce1
ARG NIXL_DEPS_IMAGE=nixl-deps:26.08-cuda13.4

# ---------------------------------------------------------------------------
# Stage 1: build nixl (UCX + OBJ plugins, cu13 wheel) and the modelexpress
# python client wheel, on top of the slow-moving nixl-deps image (aws-sdk,
# UCX, RDMA, cuobjclient dev files, uv + meson tooling).
# ---------------------------------------------------------------------------
FROM ${NIXL_DEPS_IMAGE} AS nixl-builder

# nixl fork: plain meson build first to harvest the nixl meta wheel and to
# fail closed if the OBJ plugin did not link libcuobjclient or the REST plugin
# was skipped (meson only warns when its libcurl/verbs/mlx5 checks fail). A local
# --build-context checkout carries git-ignored build dirs and a .venv (which
# `uv build` would pick up instead of the system python): drop them.
COPY --from=nixl . /workspace/nixl
WORKDIR /workspace/nixl
RUN set -e; \
    if [ -d .git ]; then \
        git config --global --add safe.directory /workspace/nixl; \
        git clean -ffdXq; \
    else \
        rm -rf build dist .mesonpy-* .venv; \
    fi; \
    meson setup -Ducx_path=/usr -Denable_plugins=UCX,OBJ,REST build/ --buildtype=release; \
    ninja -C build; \
    for plugin in OBJ REST; do \
        [ -n "$(find build -name "libplugin_${plugin}.so" | head -1)" ] \
            || { echo "ERROR: ${plugin} plugin was not built" >&2; exit 1; }; \
    done; \
    P="$(find build -name 'libplugin_OBJ.so' | head -1)"; \
    readelf -d "$P" | grep -q libcuobjclient \
        || { echo "ERROR: $P does not link libcuobjclient" >&2; exit 1; }; \
    mkdir -p /wheels \
    && cp build/src/bindings/python/nixl-meta/nixl-*.whl /wheels/

# nixl_ep (expert-parallel all-to-all for MoE) links the torch of the vLLM
# image: its extension is named after the torch minor (nixl_ep_cpp_torch214)
# and only that torch can import it. Keep TORCH_VERSION/TORCH_INDEX equal to
# the VLLM_IMAGE's torch; the final stage fails the build if they drift. Only
# headers and libraries are needed, so no --deps (no nvidia-* wheels), just the
# python modules `import torch` needs for meson's probe.
ARG TORCH_VERSION=2.14.0
ARG TORCH_INDEX=cu130
RUN uv pip install --system --no-deps \
        --index-url "https://download.pytorch.org/whl/${TORCH_INDEX}" \
        "torch==${TORCH_VERSION}" \
    && uv pip install --system typing_extensions sympy filelock jinja2 networkx fsspec \
    && python3 -c "import torch; print('nixl_ep builds against torch', torch.__version__)"

# nixl backend wheel (nixl_cu13) with nixl_ep_cu13: inject the meson setup
# args into pyproject.toml, rename the wheel, and build without isolation.
# Skip the build-requires check, whose torch pin is satisfied above. With
# build_nixl_ep, NIXL's CUDA targets default to sm_90 and newer.
RUN set -e; \
    sed -i 's|^setup = \["-Dinstall_headers=false"\]$|setup = ["-Dinstall_headers=false", "-Ducx_path=/usr", "-Denable_plugins=UCX,OBJ,REST", "-Dbuild_nixl_ep=true"]|' pyproject.toml; \
    grep -q '"-Dbuild_nixl_ep=true"' pyproject.toml \
        || { echo "ERROR: pyproject.toml sed patch failed" >&2; exit 1; }; \
    CUDA_MAJOR=$(echo "${CUDA_VERSION}" | cut -d. -f1) \
    && ./contrib/tomlutil.py --wheel-name "nixl-cu${CUDA_MAJOR}" pyproject.toml \
    && python3 -m build --wheel --no-isolation --skip-dependency-check . \
    && W="$(ls dist/nixl[-_]cu${CUDA_MAJOR}-*.whl)" \
    && { python3 -m zipfile -l "$W" | grep -q "nixl_ep_cu${CUDA_MAJOR}/nixl_ep_cpp_torch" \
        || { echo "ERROR: $W has no nixl_ep_cu${CUDA_MAJOR} extension" >&2; exit 1; }; } \
    && cp "$W" /wheels/

# modelexpress python client wheel. --no-deps at install time neutralizes the
# nixl[cu12]/torch pins; the optional vmm _alloc_ext builds with g++ and its
# failure is non-fatal in setup.py.
COPY --from=modelexpress . /modelexpress
RUN cd /modelexpress/modelexpress_client/python \
    && rm -rf .venv build dist *.egg-info \
    && python3 -m build --wheel --no-isolation --skip-dependency-check . \
    && cp dist/modelexpress-*.whl /wheels/

# Stage runtime shared libraries for the final image.
RUN set -e; \
    mkdir -p /ucxrt/lib/ucx /awslibs /cuobjrt; \
    cp -a /usr/lib/libuc*.so* /ucxrt/lib/; \
    cp -a /usr/lib/libmath.so* /ucxrt/lib/ 2>/dev/null || true; \
    cp -a /usr/lib/ucx/. /ucxrt/lib/ucx/; \
    for d in /usr/local/lib /usr/local/lib64; do \
        cp -a "$d"/libaws*.so* "$d"/libs2n.so* /awslibs/ 2>/dev/null || true; \
    done; \
    T="$(echo "$(readlink -f /usr/local/cuda)"/targets/*-linux)"; \
    cp -a "$T"/lib/libcuobjclient.so.1.* "$T"/lib/libcufile.so* /cuobjrt/

# ---------------------------------------------------------------------------
# Stage 2: modelexpress rust server binaries.
# ---------------------------------------------------------------------------
FROM rust:1.90 AS mx-builder
RUN apt-get update && apt-get -y install protobuf-compiler ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=modelexpress . /app
WORKDIR /app
RUN cargo build --release \
    && mkdir -p /mxbins \
    && cp target/release/modelexpress-server \
          target/release/modelexpress-cli \
          target/release/test_client \
          target/release/fallback_test \
          /mxbins/

# ---------------------------------------------------------------------------
# Final stage: vLLM image + wheels + runtime libs + mx server binaries.
# ---------------------------------------------------------------------------
FROM ${VLLM_IMAGE}

# Runtime deps not already present: libcurl4 for the AWS SDK, libhwloc15 for
# UCX, librdmacm for cuobjclient (libibverbs/libmlx5/libnuma are already in
# vllm-runtime-base).
RUN apt-get update && apt-get -y install --no-install-recommends \
        libcurl4 libhwloc15 librdmacm1t64 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# modelexpress python deps first (runai-model-streamer, torch, numpy and
# protobuf are already in the base image; no cuda-python, so vmm falls back to
# pool-reg).
RUN uv pip install --system \
        'grpcio>=1.66.2' \
        'google-crc32c>=1.5.0' \
        'huggingface_hub>=0.20.0' \
        'pydantic>=2.0.0'

# nixl meta + backend wheels and the modelexpress client wheel. --no-deps
# avoids the nixl wheel's torch/numpy runtime pins and the client's
# nixl[cu12] extra pulling the wrong CUDA variant.
COPY --from=nixl-builder /wheels /wheels
RUN uv pip install --system --no-deps \
        /wheels/nixl-1.6.0-*.whl \
        /wheels/nixl[-_]cu13-*.whl \
        /wheels/modelexpress-*.whl \
    && rm -rf /wheels

# nixl_ep_cu13 must match this image's torch (see TORCH_VERSION in stage 1),
# and resolve every library but libcuda.so.1, which GPU nodes inject. Importing
# it here would need that driver library, so check the file and its links.
RUN set -e; \
    TV="$(python3 -c "import torch; print(''.join(torch.__version__.split('.')[:2]))")"; \
    EP="$(python3 -c "import importlib.util, os; print(os.path.dirname(importlib.util.find_spec('nixl_ep_cu13').origin))")"; \
    SO="$(ls "$EP"/nixl_ep_cpp_torch"${TV}".*.so 2>/dev/null | head -1)"; \
    [ -n "$SO" ] || { echo "ERROR: no nixl_ep extension for torch ${TV} in $EP: $(ls "$EP")" >&2; exit 1; }; \
    MISSING="$(ldd "$SO" | grep 'not found' | grep -v 'libcuda.so.1' || true)"; \
    [ -z "$MISSING" ] || { echo "ERROR: $SO misses: $MISSING" >&2; exit 1; }; \
    echo "nixl_ep_cu13 OK: $(basename "$SO")"

# modelexpress ships p2p stubs generated for protobuf 5, which the base image's
# protobuf (6 or 7, which vLLM's tracing needs) rejects. Regenerate them with
# the grpcio-tools release of the image's grpcio, in a throwaway environment.
COPY --from=modelexpress modelexpress_common/proto/p2p.proto /tmp/mx-proto/p2p.proto
RUN set -e; \
    PKG="$(python3 -c "import importlib.util, os; print(os.path.dirname(importlib.util.find_spec('modelexpress').origin))")"; \
    GRPC="$(python3 -c "import grpc; print(grpc.__version__)")"; \
    uv run --no-project --isolated --with "grpcio-tools==${GRPC}" -- \
        python -m grpc_tools.protoc -I/tmp/mx-proto \
        --python_out="$PKG" --grpc_python_out="$PKG" /tmp/mx-proto/p2p.proto; \
    sed -i 's/^import p2p_pb2 as/from . import p2p_pb2 as/' "$PKG/p2p_pb2_grpc.py"; \
    rm -rf /tmp/mx-proto; \
    python3 -c "import modelexpress.p2p_pb2_grpc"

# UCX runtime (compiled-in module dir /usr/lib/ucx), AWS SDK + bundled CRT,
# and the cuobjclient runtime. /usr/local/lib64 is not on Ubuntu's default
# loader path, so register it.
COPY --from=nixl-builder /ucxrt/lib/. /usr/lib/
COPY --from=nixl-builder /awslibs/. /usr/local/lib64/
COPY --from=nixl-builder /cuobjrt/. /usr/local/lib64/
RUN echo /usr/local/lib64 > /etc/ld.so.conf.d/nixl-mx.conf && ldconfig

# modelexpress server binaries and cache dir. Writable by the vllm user
# (UID 2000, GID 0) for deployments that drop privileges.
COPY --from=mx-builder /mxbins/. /app/
RUN mkdir -p /app/cache && chown -R 2000:0 /app && chmod -R g+rwx /app

# Overlay this checkout's vllm python sources onto the installed vllm package
# (the build context is the vllm repo itself). The branch is python-only vs
# the base image's release tag, so its compiled extension modules match and
# no wheel rebuild is needed. cp merges: the compiled .so files and generated
# _version.py already in site-packages are kept. Files deleted in the
# checkout would linger — rebuild tier 1 if that ever happens.
COPY vllm/ /vllm-src/
RUN SP="$(python3 -c "import importlib.util, os; print(os.path.dirname(importlib.util.find_spec('vllm').origin))")" \
    && rm -f /vllm-src/_version.py \
    && cp -a /vllm-src/. "$SP"/ \
    && rm -rf /vllm-src

ENV MX_SERVER_ADDRESS=localhost:8001 \
    MODEL_EXPRESS_SERVER_PORT=8001 \
    MODEL_EXPRESS_LOG_LEVEL=info \
    MODEL_EXPRESS_CACHE_DIRECTORY=/app/cache \
    HF_HUB_CACHE=/app/cache

EXPOSE 8001

# UCX and nixl were built against CUDA 13.4 headers; the UCX CUDA modules
# dlopen libcudart.so.13, which is present in /usr/local/cuda/lib64 in the
# vLLM image. NIXL_PLUGIN_DIR is not needed: the nixl wheel layout resolves
# plugins relative to libnixl.so and the plugin rpath reaches the wheel lib
# dir. Keep vLLM's ENTRYPOINT ["vllm", "serve"].
